{
  "opencollection": "1.0.0",
  "info": {
    "name": "Cloudflare Zero Trust Network Access IP Profiles API",
    "version": "4.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "IP Profiles",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List WARP device IP profiles",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.cloudflare.com/client/v4/accounts/:account_id/devices/ip-profiles",
            "params": [
              {
                "name": "account_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "List WARP device IP profiles"
        },
        {
          "info": {
            "name": "Create a WARP IP profile",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.cloudflare.com/client/v4/accounts/:account_id/devices/ip-profiles",
            "params": [
              {
                "name": "account_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Create a WARP IP profile"
        },
        {
          "info": {
            "name": "Get a WARP IP profile",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.cloudflare.com/client/v4/accounts/:account_id/devices/ip-profiles/:profile_id",
            "params": [
              {
                "name": "account_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "profile_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get a WARP IP profile"
        },
        {
          "info": {
            "name": "Update a WARP IP profile",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://api.cloudflare.com/client/v4/accounts/:account_id/devices/ip-profiles/:profile_id",
            "params": [
              {
                "name": "account_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "profile_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Update a WARP IP profile"
        },
        {
          "info": {
            "name": "Delete a WARP IP profile",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.cloudflare.com/client/v4/accounts/:account_id/devices/ip-profiles/:profile_id",
            "params": [
              {
                "name": "account_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "profile_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Delete a WARP IP profile"
        }
      ]
    }
  ],
  "bundled": true
}